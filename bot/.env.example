# ─── Telegram ────────────────────────────────────────────────────────────────
# From @BotFather → /newbot or /token
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Your numeric Telegram user id (from @userinfobot). Only this id may add music.
TELEGRAM_OWNER_ID=123456789

# Optional: extra allowed Telegram ids, comma separated.
TELEGRAM_ALLOWED_IDS=

# Optional: proxy for reaching api.telegram.org when the provider blocks it.
# Example: http://127.0.0.1:8080 (HTTP proxy exposed by your VPN client).
# Leave empty for a direct connection.
TELEGRAM_PROXY=

# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API → service_role key. NEVER expose this on the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The Supabase Auth user id (UUID) that owns the library.
# Authentication → Users → copy the UUID of your account.
MUSE_OWNER_ID=00000000-0000-0000-0000-000000000000

# ─── MUSE ────────────────────────────────────────────────────────────────────
# Public site URL, no trailing slash. Used for the "Открыть в MUSE" button.
SITE_URL=https://your-name.github.io/MUSE

AUDIO_BUCKET=audio
COVERS_BUCKET=covers
MAX_UPLOAD_MB=20

# ─── SoundCloud (optional) ───────────────────────────────────────────────────
# Create an app at https://soundcloud.com/you/apps to enable the official API.
# Without these values the bot falls back to the official oEmbed endpoint and
# saves SoundCloud tracks as `soundcloud_embed` (played by the official widget).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# ─── Runtime ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
