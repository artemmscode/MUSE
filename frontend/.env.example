# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings → API → Project API keys → anon / public
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot username WITHOUT the @ (used for the "Open bot" button)
VITE_TELEGRAM_BOT_USERNAME=muse_music_bot

# ─── Deployment ──────────────────────────────────────────────────────────────
# Public site URL (no trailing slash). Leave empty for local development.
# GitHub Actions sets this automatically.
VITE_SITE_URL=

# Vite base path. Use "/" for a custom domain, "/MUSE/" for a project page.
# GitHub Actions sets this automatically.
VITE_BASE_PATH=/
