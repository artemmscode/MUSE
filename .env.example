# ════════════════════════════════════════════════════════════════════════════
# MUSE — master reference for every environment variable.
#
# This root file is NOT loaded by the app. It documents the two real files:
#
#   frontend/.env   ← copy from frontend/.env.example
#   bot/.env        ← copy from bot/.env.example
#
# Never commit real values. Never put service_role / bot tokens in frontend.
# ════════════════════════════════════════════════════════════════════════════

# ─── FRONTEND (frontend/.env, public — bundled into the JS) ─────────────────

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → Project API keys → anon / public
# Safe in the browser ONLY because RLS is enabled.
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Bot username without @ (used by the “Open MUSE Bot” button)
VITE_TELEGRAM_BOT_USERNAME=muse_music_bot

# Public site URL, no trailing slash. GitHub Actions fills this automatically.
# Example: https://your-name.github.io/MUSE
VITE_SITE_URL=

# Vite base path. "/" for a custom domain or a user site,
# "/MUSE/" for a project page. GitHub Actions fills this automatically.
VITE_BASE_PATH=/

# ─── BOT (bot/.env, secret — server only) ───────────────────────────────────

# @BotFather → /newbot or /token
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Your numeric Telegram id (from @userinfobot). Only this id may add music.
TELEGRAM_OWNER_ID=123456789

# Optional extra allowed Telegram ids, comma separated.
TELEGRAM_ALLOWED_IDS=

# Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API → service_role key. NEVER expose this.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase → Authentication → Users → UUID of the owner account.
# This is the SAME uuid used by RLS (auth.uid()) and by the bot.
MUSE_OWNER_ID=00000000-0000-0000-0000-000000000000

# Public site URL, no trailing slash. Used by the “Открыть в MUSE” button.
SITE_URL=https://your-name.github.io/MUSE

# Storage bucket names created by supabase/migrations/0002_storage.sql
AUDIO_BUCKET=audio
COVERS_BUCKET=covers

# Telegram Bot API limit for bot downloads is 20 MB.
MAX_UPLOAD_MB=20

# Optional official SoundCloud API app (https://soundcloud.com/you/apps).
# Without it the bot uses the official oEmbed endpoint and stores tracks as
# `soundcloud_embed` (played through the official SoundCloud widget).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

LOG_LEVEL=INFO

# ─── SUPABASE EDGE FUNCTION SECRETS (set with the Supabase CLI) ─────────────
#
# supabase secrets set \
#   TELEGRAM_BOT_TOKEN=... \
#   TELEGRAM_OWNER_ID=... \
#   MUSE_OWNER_ID=... \
#   MUSE_OWNER_EMAIL=you@example.com \
#   SITE_URL=https://your-name.github.io/MUSE
#
# MUSE_OWNER_ID is required so Telegram Mini App sign-in lands in the SAME
# account the bot writes to. Without it the Mini App would see an empty library.
